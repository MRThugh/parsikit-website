{
  "name": "parsikit-website",
  "private": true,
  "version": "3.3.1",
  "description": "Official website and documentation for ParsiKit, a production-grade pure Python library for Persian data infrastructure by Ali Kamrani.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "sync:upstream": "tsx scripts/sync-upstream.ts",
    "sync:docs": "tsx scripts/build-docs-manifest.ts",
    "build": "npm run clean && npm run sync:docs && vite build && tsx scripts/prerender.ts && npm run validate",
    "validate": "tsx scripts/validate-production.ts",
    "validate:production": "tsx scripts/validate-production.ts --require-origin",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/logic.test.ts src/lib/router.test.ts scripts/validate-production.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "smol-toml": "^1.9.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
