# ==============================================================================
# ParsiKit Website Environment Configuration Reference
# Project Owner & Author: Ali Kamrani (علی کامرانی) — @MRThugh
# Official Library Repository: https://github.com/MRThugh/ParsiKit
# Website Repository: https://github.com/MRThugh/parsikit-website
# ==============================================================================
#
# 1. LOCAL DEVELOPMENT & LOCAL BUILDS:
#    Leave all variables empty or unset.
#    The site starts and builds safely without requiring any public domain:
#      npm run dev
#      npm run build
#      npm run validate
#    In local build mode, domain-dependent production SEO artifacts
#    (sitemap.xml and absolute canonical URLs) are intentionally omitted.
#
# 2. UNDERSTANDING SITE_URL vs BASE_PATH:
#    - SITE_URL: The verified public ORIGIN of the site (protocol + domain + port).
#      Example: https://mrthugh.github.io  OR  https://your-custom-domain.example
#      NEVER include subpaths in SITE_URL.
#      NEVER invent an unverified domain (e.g. parsikit.dev).
#    - BASE_PATH: The deployment subpath if the site is not hosted at domain root.
#      Example: /parsikit-website (for GitHub Pages project sites)
#      Leave empty or unset if hosted at the domain root (apex or custom subdomain).
#
# 3. GITHUB PAGES PROJECT SITE CONFIGURATION (Standard GitHub Pages):
#    When deploying to https://<username>.github.io/<repo-name>/, configure
#    the following GitHub repository variables in
#    GitHub Settings > Secrets and variables > Actions > Variables:
#      SITE_URL=https://mrthugh.github.io
#      BASE_PATH=/parsikit-website
#
# 4. CUSTOM DOMAIN CONFIGURATION (OPTIONAL):
#    If and ONLY if you have purchased, verified, and configured a custom domain
#    in GitHub Pages (e.g. CNAME file or repository Settings > Pages):
#      SITE_URL=https://your-custom-domain.example
#      BASE_PATH=
#
# 5. STRICT ORIGIN ENFORCEMENT FOR PRODUCTION VALIDATION:
#    REQUIRE_PRODUCTION_ORIGIN=true enforces that 'npm run validate' fails
#    if SITE_URL is missing. (This is already the default for 'npm run validate:production').
#
# ==============================================================================

# Public origin (e.g. https://mrthugh.github.io or https://your-custom-domain.example)
SITE_URL=
VITE_SITE_URL=

# Static deployment base path (e.g. /parsikit-website for project site, or empty for root)
BASE_PATH=
VITE_BASE_PATH=

# Enforce that validation requires a verified public origin (true in CI deployment)
REQUIRE_PRODUCTION_ORIGIN=