# ParsiKit Website Environment Configuration Example
# Copy to .env.local for local overrides

# Production Website Base URL (REQUIRED for production deployment SEO artifacts)
# Must be set to the verified custom domain or verified hosting origin (e.g. https://your-domain.com or https://mrthugh.github.io/parsikit-website)
# Leave unset or empty during local development and preview builds.
# Never use localhost or temporary preview URLs as the production canonical URL.
SITE_URL=
VITE_SITE_URL=

# Static Deployment Base Path (Optional)
# Set to '/parsikit-website' if deploying to a GitHub Pages project site without custom domain.
# Defaults to '' (root domain deployment).
BASE_PATH=
VITE_BASE_PATH=

# Enforce verified origin during production validation
# When set to 'true', scripts/validate-production.ts fails if SITE_URL is not configured.
REQUIRE_PRODUCTION_ORIGIN=false
